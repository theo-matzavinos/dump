---
import { getCollection } from 'astro:content';
import ArticleIndex from '../components/ArticleIndex.astro';
import { SITE_DESCRIPTION } from '../consts';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getVisibleBlogPosts } from '../utils/blog';

const posts = getVisibleBlogPosts(await getCollection('blog'));
---

<SiteLayout title="Articles" description={SITE_DESCRIPTION}>
	<ArticleIndex posts={posts} current="all" heading="Articles" />
</SiteLayout>
