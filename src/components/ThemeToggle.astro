<button class="theme-toggle" type="button" data-theme-toggle aria-label="Use light theme" title="Use light theme">
	<svg class="theme-toggle__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
		<g class="theme-toggle__sun">
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
		</g>
		<path class="theme-toggle__moon" d="M20.8 13a9 9 0 0 1-9.8-9.8A9 9 0 1 0 20.8 13Z" />
	</svg>
</button>

<script>
	type Theme = 'light' | 'dark';

	const syncButtons = (theme: Theme) => {
		let label = 'Use light theme';
		if (theme === 'light') {
			label = 'Use dark theme';
		}

		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
			button.setAttribute('aria-label', label);
			button.setAttribute('title', label);
		}
	};

	const applyTheme = (theme: Theme) => {
		document.documentElement.dataset.theme = theme;
		document.documentElement.style.colorScheme = theme;
		syncButtons(theme);

		try {
			localStorage.setItem('theme-preference', theme);
		} catch {
			// Switching themes still works when browser storage is unavailable.
		}

		document.dispatchEvent(new CustomEvent('theme-changed', { detail: theme }));
	};

	const wireThemeToggle = () => {
		let theme: Theme = 'dark';
		if (document.documentElement.dataset.theme === 'light') {
			theme = 'light';
		}
		syncButtons(theme);

		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
			if (button.dataset.bound === 'true') {
				continue;
			}

			button.dataset.bound = 'true';
			button.addEventListener('click', () => {
				let nextTheme: Theme = 'light';
				if (document.documentElement.dataset.theme === 'light') {
					nextTheme = 'dark';
				}
				applyTheme(nextTheme);
			});
		}
	};

	wireThemeToggle();
	document.addEventListener('astro:after-swap', wireThemeToggle);
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: none;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 0.35rem;
		background: transparent;
		color: var(--text-primary);
		cursor: pointer;
		transition: background-color 160ms ease, color 160ms ease;
	}

	.theme-toggle:hover {
		color: var(--accent);
		background: var(--accent-soft);
	}

	.theme-toggle__moon {
		display: none;
	}

	:global([data-theme="light"]) .theme-toggle__sun {
		display: none;
	}

	:global([data-theme="light"]) .theme-toggle__moon {
		display: block;
	}

</style>
