---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	backToIndex: boolean;
}

const { backToIndex } = Astro.props;
const indexHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<header class="site-header">
	<div class="site-header__inner">
		{
			backToIndex && (
				<nav aria-label="Article navigation">
					<a class="back-link" href={indexHref}>All articles</a>
				</nav>
			)
		}
		<ThemeToggle />
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: var(--page);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		gap: 1rem;
		width: min(calc(100% - 4rem), var(--reading-width));
		min-height: 4rem;
		margin: 0 auto;
	}

	.site-header__inner :global(.theme-toggle) {
		margin-inline-start: auto;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: 1rem;
	}

	@media (max-width: 720px) {
		.site-header__inner {
			width: calc(100% - 2.5rem);
		}
	}
</style>
